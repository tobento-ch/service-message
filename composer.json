{
    "name": "tobento/service-message",
    "version": "2.0.1",
    "type": "library",
    "description": "Messages for PHP applications.",
    "keywords": [
        "tobento",
        "package",
        "messages",
        "message"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/service-collection": "^2.0",
        "tobento/service-support": "^2.0",
        "psr/log": "^3.0"
    },
    "suggest": {
        "tobento/service-translation": "Support for translating messages"
    },    
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-translation": "^2.0",
        "monolog/monolog": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Message\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Message\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}